# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service-role key: server-only, never prefixed with NEXT_PUBLIC_.
# Used by lib/supabase/admin.ts for trusted server-side work (CSV export,
# notification logging). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL — used to build absolute links (e.g. in .ics files / emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Playwright e2e admin check (optional) — a seeded account promoted to
# admin via `insert into public.user_roles (user_id, role) select id,
# 'admin' from auth.users where email = '<this email>'`.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Email notifications (optional — falls back to a logging-only adapter,
# see lib/notifications/adapter.ts)
SENDGRID_API_KEY=your-sendgrid-key

# Stripe deposits (optional — not required for the MVP booking flow,
# see lib/payments/adapter.ts)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# Google Calendar sync (optional, see lib/calendar-sync/adapter.ts)
GOOGLE_CALENDAR_CLIENT_ID=your-google-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-secret

# SMS reminders (optional, Twilio — see lib/notifications/adapter.ts)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

NODE_ENV=development
